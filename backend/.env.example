APP_ENV=development
PROJECT_NAME=Lotin tili va tibbiy terminologiya API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/latin_med_terms
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEFAULT_ADMIN_EMAIL=admin@talimtest.uz
DEFAULT_ADMIN_PASSWORD=Admin2026!
TOPIC_PASSING_SCORE=70
CERTIFICATE_QUESTION_COUNT=50
CERTIFICATE_PASSING_SCORE=70
FIREBASE_PROJECT_ID=
GOOGLE_CERTS_TIMEOUT_SECONDS=5
UPLOAD_MAX_BYTES=5242880
AUTO_CREATE_TABLES=true
SEED_ON_STARTUP=true
DEBUG=true
