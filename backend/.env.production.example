APP_ENV=production
PROJECT_NAME=Lotin tili va tibbiy terminologiya API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:strong-password@db-host:5432/latin_med_terms
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["https://your-frontend-domain.com"]
DEFAULT_ADMIN_EMAIL=admin@yourdomain.com
DEFAULT_ADMIN_PASSWORD=replace-before-first-start
TOPIC_PASSING_SCORE=70
CERTIFICATE_QUESTION_COUNT=50
CERTIFICATE_PASSING_SCORE=70
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_CERTS_TIMEOUT_SECONDS=5
UPLOAD_MAX_BYTES=5242880
AUTO_CREATE_TABLES=false
SEED_ON_STARTUP=false
DEBUG=false
